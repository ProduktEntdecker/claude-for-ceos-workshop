#!/bin/bash
# Pre-commit hook: blocks secrets and PII from being committed.
#
# Based on the init-repo skill template, hardened for this repository:
# - scans only lines that the staged diff adds, so removing a secret never blocks
# - reports file and pattern category, never the matching content
# - passes patterns with -e (one starts with dashes) and uses POSIX classes,
#   because BSD grep on macOS reads \s literally inside bracket expressions
# - finds e-mail addresses with grep -o and filters an allowlist afterwards,
#   because grep -E has no lookahead
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Tests:   bash scripts/hooks/test-pre-commit.sh

set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# "category|regex", matched case-insensitively against added lines
SECRET_PATTERNS=(
    'Anthropic API key|sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}'
    'OpenAI API key|sk-[A-Za-z0-9]{20,}'
    'generic API key|api[_-]?key["[:space:]:=]+[A-Za-z0-9_-]{20,}'
    'generic API secret|api[_-]?secret["[:space:]:=]+[A-Za-z0-9_-]{20,}'
    'AWS access key id|AKIA[0-9A-Z]{16}'
    'AWS secret access key|aws[_-]?secret[_-]?access[_-]?key'
    'private key|-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'
    'GitHub token|gh[po]_[A-Za-z0-9]{36}'
    'GitLab token|glpat-[A-Za-z0-9_-]{20,}'
    'passwords in plain text|password["[:space:]:=]+[^[:space:]]{8,}'
    'secrets in plain text|secret["[:space:]:=]+[^[:space:]]{16,}'
)

# "category|regex", matched case-sensitively against added lines
PII_PATTERNS=(
    'German IBAN|DE[0-9]{20}'
    'German phone number|\+49[0-9 ()-]{6,}'
)

EMAIL_REGEX='[A-Za-z0-9._%+-]+@([A-Za-z0-9-]+\.)+[A-Za-z]{2,}'
# Reserved example domains (RFC 2606) and test addresses may be committed.
EMAIL_ALLOW='@(([A-Za-z0-9-]+\.)*example(\.(com|org|net))?|test\.com)$'

SENSITIVE_FILES=(
    '\.env$'
    '\.pem$'
    '\.key$'
    'credentials'
    'id_rsa'
    'id_ed25519'
)

# Lines added to one staged file, without the leading "+" and without file headers.
added_lines() {
    git -c core.quotepath=off diff --cached -U0 --diff-filter=d -- "$1" \
        | grep -E '^\+' | grep -vE '^\+\+\+ ' | cut -c2-
}

echo ""
echo -e "${YELLOW}PRE-COMMIT SECURITY CHECK${NC}"
echo ""

STAGED_FILES=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=d)
if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No files staged${NC}"
    exit 0
fi

FAILED=0

echo -e "${YELLOW}[1/2] Scanning added lines for secrets and PII...${NC}"
while IFS= read -r file; do
    [ -n "$file" ] || continue
    content=$(added_lines "$file")
    [ -n "$content" ] || continue
    for entry in "${SECRET_PATTERNS[@]}"; do
        if printf '%s\n' "$content" | grep -iqE -e "${entry#*|}"; then
            echo -e "${RED}BLOCKED: possible ${entry%%|*} in $file${NC}"
            FAILED=1
        fi
    done
    for entry in "${PII_PATTERNS[@]}"; do
        if printf '%s\n' "$content" | grep -qE -e "${entry#*|}"; then
            echo -e "${RED}BLOCKED: possible ${entry%%|*} in $file${NC}"
            FAILED=1
        fi
    done
    if printf '%s\n' "$content" | grep -oE -e "$EMAIL_REGEX" | grep -viqE -e "$EMAIL_ALLOW"; then
        echo -e "${RED}BLOCKED: possible e-mail address in $file${NC}"
        FAILED=1
    fi
done <<< "$STAGED_FILES"

echo -e "${YELLOW}[2/2] Checking file names...${NC}"
while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
        *.example*|*.template*|*.sample*) continue ;;
    esac
    for pattern in "${SENSITIVE_FILES[@]}"; do
        if printf '%s\n' "$file" | grep -qE -e "$pattern"; then
            echo -e "${RED}BLOCKED: sensitive file name: $file${NC}"
            FAILED=1
        fi
    done
done <<< "$STAGED_FILES"

echo ""
if [ "$FAILED" -eq 1 ]; then
    echo -e "${RED}COMMIT BLOCKED: security issues found${NC}"
    echo "The matching content is not printed. Inspect the named files, remove the value, stage again."
    echo "To bypass (NOT RECOMMENDED): git commit --no-verify"
    echo ""
    exit 1
fi
echo -e "${GREEN}All security checks passed${NC}"
echo ""
exit 0
