#!/bin/bash
# Pre-commit hook - Blocks secrets and PII from being committed
#
# Created by init-repo skill
# Purpose: Prevent API keys, secrets, and PII from being committed
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: bash scripts/install-hooks.sh

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${YELLOW}PRE-COMMIT SECURITY CHECK${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No files staged${NC}"
    exit 0
fi

FAILED=0

# ============================================
# 1. API KEY / SECRET PATTERNS
# ============================================
echo -e "${YELLOW}[1/3] Scanning for API keys and secrets...${NC}"

SECRET_PATTERNS=(
    # Anthropic API keys
    'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}'
    # OpenAI API keys
    'sk-[A-Za-z0-9]{20,}'
    # Generic API key patterns
    'api[_-]?key["[:space:]:=]+[A-Za-z0-9_-]{20,}'
    'api[_-]?secret["[:space:]:=]+[A-Za-z0-9_-]{20,}'
    # AWS
    'AKIA[0-9A-Z]{16}'
    'aws[_-]?secret[_-]?access[_-]?key'
    # Private keys
    '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'
    # GitHub tokens
    'ghp_[A-Za-z0-9]{36}'
    'gho_[A-Za-z0-9]{36}'
    # GitLab tokens
    'glpat-[A-Za-z0-9_-]{20,}'
    # Generic secrets
    'password["[:space:]:=]+[^[:space:]]{8,}'
    'secret["[:space:]:=]+[^[:space:]]{16,}'
)

for pattern in "${SECRET_PATTERNS[@]}"; do
    # Search staged content for secrets
    if git diff --cached -U0 | grep -iE "$pattern" > /dev/null 2>&1; then
        echo -e "${RED}BLOCKED: Found potential secret matching pattern: $pattern${NC}"
        echo ""
        echo "Matches found in staged changes:"
        git diff --cached -U0 | grep -iE "$pattern" | head -5
        echo ""
        FAILED=1
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}No API keys or secrets detected${NC}"
fi

# ============================================
# 2. PII PATTERNS (German-focused)
# ============================================
echo ""
echo -e "${YELLOW}[2/3] Scanning for PII...${NC}"

PII_PATTERNS=(
    # German IBAN
    'DE[0-9]{20}'
    # Email addresses (but allow example.com and test domains)
    '[A-Za-z0-9._%+-]+@(?!example\.com|test\.com|localhost)[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
    # German phone numbers
    '\+49[0-9 ()-]{6,}'
)

for pattern in "${PII_PATTERNS[@]}"; do
    if git diff --cached -U0 | grep -E "$pattern" > /dev/null 2>&1; then
        echo -e "${RED}BLOCKED: Found potential PII matching pattern: $pattern${NC}"
        git diff --cached -U0 | grep -E "$pattern" | head -3
        FAILED=1
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}No PII detected${NC}"
fi

# ============================================
# 3. SENSITIVE FILE PATTERNS
# ============================================
echo ""
echo -e "${YELLOW}[3/3] Checking for sensitive files...${NC}"

SENSITIVE_FILES=(
    '.env$'
    '\.pem$'
    '\.key$'
    'credentials'
    'id_rsa'
    'id_ed25519'
)

for file in $STAGED_FILES; do
    for pattern in "${SENSITIVE_FILES[@]}"; do
        if echo "$file" | grep -E "$pattern" > /dev/null 2>&1; then
            # Allow .env.example and similar template files
            if [[ "$file" == *".example"* ]] || [[ "$file" == *".template"* ]] || [[ "$file" == *".sample"* ]]; then
                continue
            fi
            echo -e "${RED}BLOCKED: Attempting to commit sensitive file: $file${NC}"
            FAILED=1
        fi
    done
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}No sensitive files detected${NC}"
fi

# ============================================
# RESULT
# ============================================
echo ""
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ $FAILED -eq 1 ]; then
    echo -e "${RED}COMMIT BLOCKED - Security issues found${NC}"
    echo ""
    echo "To bypass (NOT RECOMMENDED): git commit --no-verify"
    echo "To fix: Remove secrets/PII from staged files"
    echo ""
    exit 1
else
    echo -e "${GREEN}All security checks passed${NC}"
    echo ""
    exit 0
fi
